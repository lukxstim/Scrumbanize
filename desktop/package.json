{
  "name": "@scrumbanize/desktop",
  "version": "1.1.0",
  "private": true,
  "productName": "Scrumbanize",
  "description": "Scrumbanize – Notizen und Scrumban-Board als Desktop-App für Windows und macOS",
  "author": "Scrumbanize",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node build.mjs",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win --x64 --publish never",
    "dist:mac": "npm run build && electron-builder --mac --universal --publish never",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "koffi": "^2.16.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
