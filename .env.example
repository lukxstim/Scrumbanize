# Scrumbanize – Einstellungen für den Betrieb mit Docker Compose (US-23)
#
# Kopieren und anpassen:   cp .env.example .env
# Die Datei .env bleibt auf dem Server; sie ist von Git und vom Docker-Build ausgenommen.
# Leere Werte gelten als nicht gesetzt. Der Server prüft alle Werte beim Start und nennt, was nicht stimmt
# (docker compose logs scrumbanize).

# ── Öffentliche Adresse ──────────────────────────────────────────────────────────────────────────────────────────

# Domain, unter der Scrumbanize erreichbar ist. Caddy holt dafür automatisch ein Let's-Encrypt-Zertifikat.
# Der DNS-Eintrag (A bzw. AAAA) muss schon auf den Server zeigen, und die Ports 80 und 443 müssen offen sein.
# Nur der Host-Name, ohne https:// und ohne Pfad.
DOMAIN=scrumbanize.example.org

# E-Mail-Adresse für Let's Encrypt: Hinweise zu ablaufenden Zertifikaten und Problemen.
ACME_EMAIL=admin@example.org

# Öffentliche Adresse der App. Leer lassen: dann gilt https://DOMAIN.
# Nur nötig, wenn die App unter einer anderen Adresse erreichbar ist, z. B. mit Port.
BASE_URL=

# Weitere Adressen, deren Seiten Änderungen schicken dürfen, kommagetrennt – etwa eine zweite Domain, die auf
# denselben Server zeigt. Normalerweise leer.
ALLOWED_ORIGINS=

# ── Anmeldung ────────────────────────────────────────────────────────────────────────────────────────────────────

# Anmeldung mit E-Mail und Passwort: on (Standard) oder off.
# off nur in einem vertrauenswürdigen Netz: Dann kann jede Person, die den Server erreicht, alles sehen und ändern.
AUTH=on

# ── Backups ──────────────────────────────────────────────────────────────────────────────────────────────────────

# Uhrzeit des täglichen Backups (24 Stunden, z. B. 03:00) oder off. Die Backups landen auf dem Server im
# Verzeichnis ./backups neben der docker-compose.yml – von dort lassen sie sich extern sichern.
BACKUP_TIME=03:00

# Wie viele tägliche Backups aufgehoben werden (1–365); ältere werden gelöscht.
BACKUP_KEEP=14

# Zeitzone für BACKUP_TIME und die Zeitangaben im Log, z. B. Europe/Berlin oder UTC.
TZ=Europe/Berlin

# ── Nur für besondere Fälle ──────────────────────────────────────────────────────────────────────────────────────

# PORT, DATA_DIR, NODE_ENV und TRUST_PROXY setzt docker-compose.yml fest (die App hinter Caddy im internen Netz);
# Werte dafür in dieser Datei gelten dort nicht.

# Versionsangabe für /api/health. Standard: die Version aus desktop/package.json.
# APP_VERSION=
